{
  "name": "harnes",
  "version": "0.1.10",
  "description": "Dein KI-Team im Terminal: Claude, Codex, DeepSeek und lokale Modelle arbeiten als ein Team – Team-Chat, Aufgabenbrett, Obsidian-Gedächtnis und ein Begleiter mit Stimme.",
  "type": "module",
  "private": true,
  "bin": {
    "harnes": "dist/cli.js",
    "remoteharnes": "dist/cli.js",
    "rh": "dist/cli.js",
    "harnesremote": "dist/cli.js",
    "harnes-browser": "dist/browser-start.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "paket": "node scripts/paket.mjs",
    "postinstall": "node scripts/nach-installation.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "chalk": "6.0.1",
    "ink": "^8.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "string-width": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.3",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "browser",
    "begleiter/bin",
    "scripts/nach-installation.cjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/davidhbg/harnes.git"
  },
  "homepage": "https://github.com/davidhbg/harnes",
  "bugs": {
    "url": "https://github.com/davidhbg/harnes/issues"
  },
  "keywords": [
    "ki",
    "ai",
    "claude",
    "codex",
    "deepseek",
    "ollama",
    "team",
    "terminal",
    "agents",
    "mcp"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "davidhbg (https://github.com/davidhbg)"
}
